<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="category_triggers"
        android:title="@string/category_triggers_title">
        <Preference
            android:key="triggers_entry"
            android:title="@string/triggers_enabled_title"
            android:summary="@string/triggers_entry_summary"
            app:fragment="org.lineageos.settings.ares.ui.TriggersSettingsFragment" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_lighting"
        android:title="@string/category_lighting_title">
        <Preference
            android:key="lighting_placeholder"
            android:title="@string/lighting_placeholder_title"
            android:summary="@string/lighting_placeholder_summary"
            android:enabled="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_vibration"
        android:title="@string/category_vibration_title">
        <Preference
            android:key="vibration_placeholder"
            android:title="@string/vibration_placeholder_title"
            android:summary="@string/vibration_placeholder_summary"
            android:enabled="false" />
    </PreferenceCategory>

</PreferenceScreen>
